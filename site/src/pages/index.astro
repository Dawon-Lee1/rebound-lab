---
import Base from "../layouts/Base.astro";
import PlayerTable, { type Col } from "../components/PlayerTable.astro";
import TopCards from "../components/TopCards.astro";
import { meta, players, type Player } from "../data/players";
import { about } from "../data/glossary";
import { cbaNotice } from "../data/notice";

const season = meta.data_season;
const updated = new Date(meta.generated_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const byRank = (f: (p: Player) => number | null) => (a: Player, b: Player) => (f(a) ?? 0) - (f(b) ?? 0);

const base: Col[] = [
  { key: "pa", value: (p) => p.pa, kind: "int" },
  { key: "woba", value: (p) => p.woba, kind: "rate" },
  { key: "xwoba", value: (p) => p.xwoba, kind: "rate" },
  { key: "luck", value: (p) => p.luck, kind: "luck", core: true },
  { key: "change", value: (p) => p.rebound_score, kind: "signed", core: true },
];
const tabs = [
  {
    id: "luck",
    name: "Buy-Low",
    intro: "Hitters whose contact quality (xwOBA) ran ahead of their results. Unluckiest first.",
    caption: "Buy-Low: sorted by Luck",
    rank: (p: Player) => p.rank_luck,
    rows: players.filter((p) => p.in_buylow_tab),
    columns: base,
  },
  {
    id: "sell",
    name: "Sell-High",
    intro: "Hitters whose results ran ahead of their contact quality (xwOBA). Luckiest first.",
    caption: "Sell-High: sorted by Luck, most negative first",
    rank: (p: Player) => p.rank_sell,
    rows: players.filter((p) => p.in_sell_tab),
    columns: base,
  },
  {
    id: "rebound",
    name: "Rebound",
    intro: `Hitters with ${meta.rebound_tab_min_pa}+ PA, sorted by projected change in wOBA (Luck plus Regression).`,
    caption: "Rebound: sorted by Proj. change",
    rank: (p: Player) => p.rank_rebound,
    rows: players.filter((p) => p.in_rebound_tab),
    columns: [
      base[0],
      base[1],
      { key: "proj", value: (p) => p.proj_woba_2027, kind: "rate" },
      base[3],
      { key: "regression", value: (p) => p.regression, kind: "signed" },
      base[4],
    ] as Col[],
  },
].map((t) => ({ ...t, rows: t.rows.sort(byRank(t.rank)) }));

const counts = [
  [players.length, `hitters with ${meta.min_pa_show}+ PA`],
  [tabs[0].rows.length, "Buy-Low: Luck above zero"],
  [tabs[1].rows.length, "Sell-High: Luck below zero"],
] as const;
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Rebound Lab",
  url: new URL("/", Astro.site).href,
  description: `Which ${season} MLB hitters were unlucky, and who got lucky? A free buy-low and sell-high board for ${season + 1} fantasy baseball drafts.`,
};
---

<Base
  title={`${season + 1} Hitter Buy-Low Board`}
  description={`Which ${season} MLB hitters were unlucky, and who got lucky? Expected stats vs results for ${players.length} hitters, for ${season + 1} fantasy drafts.`}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(website)} />
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h">Which {season} hitters were unlucky — and who just got lucky?</h1>
    <p class="lede">
      {season} regular-season data, updated {updated}. {cbaNotice}
    </p>
    <dl class="linescore">
      {
        counts.map(([n, label]) => (
          <div>
            <dt>{label}</dt>
            <dd class="num" data-count={n}>{n}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <details class="glossary" id="glossary">
    <summary>What do these columns mean?</summary>
    <dl>
      {
        Object.values(about).map(([term, text]) => (
          <div>
            <dt>{term}</dt>
            <dd>{text}</dd>
          </div>
        ))
      }
    </dl>
  </details>

  <div role="tablist" aria-label="Rankings" class="tabs">
    {
      tabs.map((t, i) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={String(i === 0)} tabindex={i ? -1 : 0}>
          {t.name}
        </button>
      ))
    }
  </div>

  {
    tabs.map((t) => (
      <section role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="panel">
        <h2 class="panel-h">{t.name}</h2>
        <p class="muted">{t.intro}</p>
        <TopCards rows={t.rows} rank={t.rank} />
        <PlayerTable id={t.id} caption={t.caption} rows={t.rows} rank={t.rank} columns={t.columns} />
      </section>
    ))
  }
</Base>

<style>
  .hero {
    margin-bottom: 36px;
  }
  h1 {
    max-width: 18ch;
  }
  .lede {
    color: var(--muted);
  }
  .linescore {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 640px;
    margin: 28px 0 0;
    border: 2px solid var(--ink);
  }
  .linescore div {
    display: flex;
    flex-direction: column-reverse;
    padding: 10px 14px 12px;
  }
  .linescore div + div {
    border-left: 1px solid var(--rule);
  }
  .linescore dt {
    font-size: var(--s-1);
    color: var(--muted);
    line-height: 1.3;
  }
  .linescore dd {
    margin: 0 0 4px;
    font-size: clamp(var(--s3), 7vw, var(--s4));
    line-height: 1;
  }
  .glossary {
    margin: 0 0 28px;
    font-size: var(--s-1);
  }
  .glossary summary {
    cursor: pointer;
    font-weight: 600;
    padding-block: 6px;
  }
  .glossary dl {
    margin: 8px 0 0;
    max-width: 72ch;
  }
  .glossary div {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 12px;
    padding-block: 6px;
    border-top: 1px solid var(--hair);
  }
  .glossary dt {
    font-weight: 600;
  }
  .glossary dd {
    margin: 0;
  }
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 20px;
  }
  /* No JS: no tabs, all panels show. With JS (class set in <head> before first paint) only the first panel shows until the script takes over */
  :global(html:not(.js)) .tabs {
    display: none;
  }
  :global(.js:not(.tabs-ready)) .panel + .panel {
    display: none;
  }
  .tabs button {
    font: 600 var(--s0) var(--f-body);
    color: var(--muted);
    background: none;
    border: 0;
    border-bottom: 4px solid transparent;
    margin-bottom: -2px;
    padding: 10px 14px 8px;
    white-space: nowrap;
    cursor: pointer;
  }
  .tabs button[aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .tabs button:hover {
    color: var(--ink);
  }
  .panel + .panel {
    margin-top: 56px;
  }
  /* With JS the tab already names the panel; without JS the heading separates the three lists */
  :global(.js) .panel-h {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  :global(.js) .panel + .panel {
    margin-top: 0;
  }
  @media (max-width: 479px) {
    .tabs button {
      padding-inline: 8px;
    }
    .linescore div {
      padding: 8px 10px 10px;
    }
  }
</style>

<script>
  // Without JS the tablist stays hidden and all panels show. With JS: ARIA tabs, arrows/Home/End switch.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const select = (t: HTMLButtonElement) => {
    for (const x of tabs) {
      const on = x === t;
      x.setAttribute("aria-selected", String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute("aria-controls")!)!.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    t.addEventListener("keydown", (e) => {
      const last = tabs.length - 1;
      const j = (<Record<string, number>>{ ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i + last) % tabs.length, Home: 0, End: last })[e.key];
      if (j === undefined) return;
      e.preventDefault();
      const n = tabs[j];
      select(n);
      n.focus();
    });
  });
  select(tabs[0]);
  document.documentElement.classList.add("tabs-ready");

  // Links to the glossary open it; a closed <details> would otherwise scroll into view still collapsed.
  const glossary = document.getElementById("glossary") as HTMLDetailsElement;
  for (const a of document.querySelectorAll('a[href="#glossary"]')) a.addEventListener("click", () => (glossary.open = true));

  // One count-up on load. The HTML already holds the final number, so no-JS and reduced motion show it as is.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-count]")) {
      const end = Number(el.dataset.count);
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.max(0, Math.min(1, (t - t0) / 600)); // rAF time can be a bit before t0
        el.textContent = String(Math.round(end * (1 - (1 - k) ** 3)));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }
</script>
